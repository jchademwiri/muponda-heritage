---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname === '/' ? '/' : pathname.replace(/\/$/, '');

const links = [
  { href: '/', label: 'Home' },
  { href: '/culture', label: 'Culture' },
  { href: '/history', label: 'History' },
  { href: '/totem', label: 'Totem' },
  { href: '/poem', label: 'Poem' },
];
---

<nav class='bg-card border-b border-border shadow-md sticky top-0 z-50'>
  <div class='max-w-[var(--container-width)] mx-auto px-4 sm:px-6 lg:px-8'>
    <div class='flex justify-between h-16'>
      <div class='flex items-center'>
        <!-- Logo -->
        <a href='/' class='shrink-0 flex items-center gap-2 group'>
          <div
            class='h-10 w-10 bg-muponda-green rounded-full flex items-center justify-center text-white font-bold text-xl border-2 border-muponda-gold group-hover:bg-green-800 transition'
          >
            M
          </div>
          <span class='font-bold text-xl text-foreground tracking-tight'
            >Muponda Dynasty</span
          >
        </a>
      </div>

      <!-- Desktop Menu -->
      <div class='hidden md:flex items-center space-x-8'>
        {
          links.map((link) => (
            <a
              href={link.href}
              class:list={[
                'font-medium transition',
                currentPath === link.href
                  ? 'text-primary font-bold'
                  : 'text-muted-foreground hover:text-primary',
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <a
          href='/join'
          class='px-4 py-2 rounded-full bg-primary text-primary-foreground hover:opacity-90 transition shadow-sm font-semibold'
        >
          Join Family Portal
        </a>
      </div>

      <!-- Theme Toggle -->
      <button
        id='theme-toggle'
        class='p-2 rounded-full hover:bg-muted text-muted-foreground transition'
        aria-label='Toggle Theme'
      >
        <i class='fas fa-sun dark:hidden'></i>
        <i class='fas fa-moon hidden dark:block'></i>
      </button>

      <!-- Mobile Menu Button -->
      <div class='flex items-center md:hidden'>
        <button
          id='mobile-menu-btn'
          class='text-muted-foreground hover:text-foreground focus:outline-none'
        >
          <i class='fas fa-bars text-2xl'></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id='mobile-menu'
    class='hidden md:hidden bg-card border-t border-border pb-4 px-4 shadow-lg'
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class='block py-3 w-full text-left text-muted-foreground font-medium border-b border-border hover:text-primary'
        >
          {link.label}
        </a>
      ))
    }
    <a href='/join' class='block py-3 w-full text-left text-primary font-bold'
      >Join Portal</a
    >
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
  });
</script>
