---
const year = new Date().getFullYear();
---

<footer
  class='bg-muted text-muted-foreground py-8 mt-auto border-t border-border'
>
  <div class='max-w-[var(--container-width)] mx-auto px-4 text-center'>
    <div class='mb-4'>
      <span class='text-2xl font-bold tracking-tight text-primary'
        >Muponda Dynasty</span
      >
    </div>
    <p class='text-muted-foreground/80 text-sm mb-4'>
      Mwaita Nyere. Mwaita Nzvidzi.
    </p>
    <div class='border-t border-border pt-4'>
      <p class='text-xs text-muted-foreground/60'>
        &copy; {year} Muponda Dynasty Heritage Project. All rights reserved.
      </p>
    </div>
  </div>
</footer>
