    <div class='mb-4'>
      <span class='text-2xl font-bold tracking-tight text-muponda-gold'
        >Muponda Dynasty</span
      >
    </div>
    <p class='text-gray-400 text-sm mb-4'>Mwaita Nyere. Mwaita Nzvidzi.</p>
    <div class='border-t border-gray-800 pt-4'>
      <p class='text-xs text-gray-500'>
        &copy; {year} Muponda Dynasty Heritage Project. All rights reserved.
      </p>
    </div>
  </div>
</footer>
