---
const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Heritage',
    links: [
      { href: '/history', label: 'History' },
      { href: '/culture', label: 'Culture' },
      { href: '/totem', label: 'Totem' },
      { href: '/poem', label: 'Praise Poem' },
      { href: '/elders', label: 'Elders & Leaders' },
    ],
  },
  {
    heading: 'Family',
    links: [
      { href: '/family-tree', label: 'Family Tree' },
      { href: '/gallery', label: 'Gallery' },
      { href: '/stories', label: 'Family Stories' },
      { href: '/events', label: 'Events' },
      { href: '/directory', label: 'Business Directory' },
    ],
  },
  {
    heading: 'About',
    links: [
      { href: '/about', label: 'About This Project' },
      { href: '/join', label: 'Join Family Portal' },
      { href: '/faq', label: 'FAQ' },
      { href: '/contact', label: 'Contact' },
    ],
  },
];
---

<footer
  class='bg-muted text-muted-foreground pt-12 pb-8 mt-auto border-t border-border'
>
  <div class='max-w-[var(--container-width)] mx-auto px-4'>
    <div class='grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 mb-10'>
      <div>
        <span class='text-2xl font-bold tracking-tight text-primary'
          >Muponda Dynasty</span
        >
        <p class='text-muted-foreground/80 text-sm mt-3'>
          Mwaita Nyere. Mwaita Nzvidzi.
        </p>
      </div>
      {
        columns.map((col) => (
          <div>
            <h3 class='text-xs font-bold uppercase tracking-widest text-foreground mb-3'>
              {col.heading}
            </h3>
            <ul class='space-y-2'>
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class='text-sm hover:text-primary transition'
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class='border-t border-border pt-4 text-center'>
      <p class='text-xs text-muted-foreground/60'>
        &copy; {year} Muponda Dynasty Heritage Project. All rights reserved.
      </p>
    </div>
  </div>
</footer>
