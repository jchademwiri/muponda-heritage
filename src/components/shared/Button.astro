---
interface Props {
  href: string;
  variant?: 'primary' | 'light' | 'outline' | 'ghost';
  icon?: string;
  class?: string;
}

const { href, variant = 'primary', icon, class: className = '' } = Astro.props;

const variants = {
  primary:
    'bg-primary text-primary-foreground hover:opacity-90 shadow-lg shadow-primary/20',
  light:
    'bg-background text-primary hover:bg-muted shadow-lg',
  outline:
    'border border-white/40 text-white hover:bg-white/10 backdrop-blur-sm',
  ghost: 'bg-white/10 hover:bg-white/20 text-white border border-white/20',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 px-8 py-3 rounded-full font-semibold text-base transition duration-300 transform hover:-translate-y-0.5',
    variants[variant],
    className,
  ]}
>
  {icon && <i class={`fas ${icon}`} />}
  <slot />
</a>
