---
interface Props {
  text?: string;
}

const {
  text = 'Placeholder content — this section will be updated with real family information.',
} = Astro.props;
---

<div
  class='flex items-start gap-3 bg-muponda-gold/10 border border-muponda-gold/40 text-sm text-foreground/80 rounded-lg px-4 py-3 mb-8'
>
  <i class='fas fa-pen-nib text-muponda-gold mt-0.5'></i>
  <p>{text}</p>
</div>
