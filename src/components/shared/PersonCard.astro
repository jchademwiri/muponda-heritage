---
import { getPerson, getSpouses, type FamilyMember } from '@/data/families';

interface Props {
  person: FamilyMember;
  members: FamilyMember[];
}

const { person, members } = Astro.props;
const father = person.fatherId ? getPerson(members, person.fatherId) : undefined;
const mother = person.motherId ? getPerson(members, person.motherId) : undefined;
const spouses = getSpouses(members, person.id);
---

<div
  class='group bg-card border border-border rounded-xl p-6 hover:shadow-lg hover:-translate-y-1 transition duration-300 flex flex-col'
>
  <div
    class='w-12 h-12 rounded-lg bg-muponda-green/10 text-muponda-green flex items-center justify-center mb-4 text-xl group-hover:bg-muponda-green group-hover:text-white transition'
  >
    <i class='fas fa-user' />
  </div>

  <div class='flex items-start justify-between gap-2 mb-1'>
    <h3 class='text-lg font-bold text-foreground'>{person.name}</h3>
    {
      !person.confirmed && (
        <span class='shrink-0 text-[10px] uppercase tracking-wide font-bold px-2 py-0.5 rounded-full bg-muponda-gold/20 text-yellow-700'>
          unconfirmed
        </span>
      )
    }
  </div>

  {
    person.birthYear && (
      <p class='text-xs text-muted-foreground mb-3'>Born {person.birthYear}</p>
    )
  }

  <div class='text-sm text-muted-foreground space-y-1'>
    {
      father && (
        <p>
          <i class='fas fa-male w-4 text-muponda-purple' /> Father: {father.name}
        </p>
      )
    }
    {
      mother && (
        <p>
          <i class='fas fa-female w-4 text-muponda-purple' /> Mother: {mother.name}
        </p>
      )
    }
    {
      spouses.length > 0 && (
        <p>
          <i class='fas fa-heart w-4 text-muponda-earth' /> Spouse
          {spouses.length > 1 ? 's' : ''}: {spouses.map((s) => s.name).join(', ')}
        </p>
      )
    }
  </div>

  {
    person.notes && (
      <p class='text-xs text-muted-foreground italic mt-3 pt-3 border-t border-border'>
        {person.notes}
      </p>
    )
  }
</div>
