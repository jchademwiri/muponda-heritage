---
interface Props {
  name: string;
  shonaName: string;
  description: string;
  icon: string;
  borderColorClass: string; // e.g., 'border-muponda-purple'
  iconBgClass: string; // e.g., 'bg-purple-100'
  iconTextClass: string; // e.g., 'text-muponda-purple'
}

const {
  name,
  shonaName,
  description,
  icon,
  borderColorClass,
  iconBgClass,
  iconTextClass,
} = Astro.props;
---

<div
  class={`bg-card p-6 rounded-xl shadow-md border-b-4 hover:-translate-y-1 transition duration-300 ${borderColorClass}`}
>
  <div
    class={`w-12 h-12 rounded-full flex items-center justify-center mb-4 text-xl ${iconBgClass} ${iconTextClass}`}
  >
    <i class={`fas ${icon}`}></i>
  </div>
  <h3 class='text-xl font-bold text-card-foreground mb-2'>{name}</h3>
  <p class='text-sm text-muted-foreground font-semibold mb-2'>"{shonaName}"</p>
  <p class='text-muted-foreground text-sm'>{description}</p>
</div>
