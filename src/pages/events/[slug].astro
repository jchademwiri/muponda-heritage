---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import PlaceholderNotice from '@/components/shared/PlaceholderNotice.astro';
import { events } from '@/data/events';

export function getStaticPaths() {
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
---

<Layout
  title={event.title}
  description={event.description}
>
  <PageHero
    eyebrow='Zviitiko'
    title={event.title}
    subtitle={event.location}
    bgClass='bg-muponda-green'
  />

  <div class='max-w-3xl mx-auto px-6 py-16'>
    <a
      href='/events'
      class='inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary transition mb-8'
    >
      <i class='fas fa-arrow-left' /> All Events
    </a>

    <PlaceholderNotice text='Full details for this event are still to come — see CONTENT-NEEDED.md.' />

    <div class='bg-card border border-border rounded-xl p-6 md:p-10'>
      <div class='flex flex-col sm:flex-row gap-6 mb-8'>
        <div class='shrink-0'>
          <div class='inline-flex flex-col items-center sm:items-start bg-muted rounded-lg px-4 py-2'>
            <i class='fas fa-calendar-days text-primary mb-1' />
            <span class='text-sm font-bold text-foreground'>{event.date}</span>
          </div>
        </div>
        <div>
          <p class='text-sm text-muted-foreground'>
            <i class='fas fa-location-dot mr-1' />
            {event.location}
          </p>
        </div>
      </div>

      <p class='text-muted-foreground leading-relaxed mb-6'>
        {event.description}
      </p>

      <div class='border-t border-border pt-6'>
        <h2 class='text-lg font-bold text-foreground mb-3'>Details</h2>
        <p class='text-muted-foreground leading-relaxed'>{event.details}</p>
      </div>
    </div>
  </div>
</Layout>
