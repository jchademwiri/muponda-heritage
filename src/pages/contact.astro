---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import PlaceholderNotice from '@/components/shared/PlaceholderNotice.astro';
---

<Layout
  title='Contact'
  description='Get in touch with the Muponda Dynasty Heritage Project administrators.'
>
  <PageHero
    eyebrow='Taurirana Nesu'
    title='Contact Us'
    subtitle='Questions, corrections, or family information to share? Reach out.'
    bgClass='bg-muponda-green'
  />

  <div class='max-w-3xl mx-auto px-6 py-16'>
    <PlaceholderNotice text='Replace with real admin contact details (email, phone, WhatsApp, social).' />

    <div class='grid grid-cols-1 sm:grid-cols-3 gap-6 mb-12 text-center'>
      <div class='bg-card border border-border rounded-lg p-6'>
        <i class='fas fa-envelope text-2xl text-primary mb-3'></i>
        <p class='font-bold text-foreground text-sm'>Email</p>
        <p class='text-muted-foreground text-sm'>[admin@example.com]</p>
      </div>
      <div class='bg-card border border-border rounded-lg p-6'>
        <i class='fas fa-phone text-2xl text-primary mb-3'></i>
        <p class='font-bold text-foreground text-sm'>Phone / WhatsApp</p>
        <p class='text-muted-foreground text-sm'>[+263 xx xxx xxxx]</p>
      </div>
      <div class='bg-card border border-border rounded-lg p-6'>
        <i class='fas fa-location-dot text-2xl text-primary mb-3'></i>
        <p class='font-bold text-foreground text-sm'>Region</p>
        <p class='text-muted-foreground text-sm'>[Manyika, Zimbabwe]</p>
      </div>
    </div>

    <div class='bg-card p-8 rounded-xl shadow-lg border border-border'>
      <form
        onsubmit="event.preventDefault(); alert('Thank you! This is a preview. In the real app, this sends data.');"
      >
        <div class='space-y-6'>
          <div>
            <label class='block text-sm font-medium text-foreground mb-1'
              >Name</label
            ><input
              type='text'
              class='w-full px-4 py-2 border border-input rounded-md bg-background text-foreground'
              placeholder='Your name'
            />
          </div>
          <div>
            <label class='block text-sm font-medium text-foreground mb-1'
              >Email</label
            ><input
              type='email'
              class='w-full px-4 py-2 border border-input rounded-md bg-background text-foreground'
              placeholder='you@example.com'
            />
          </div>
          <div>
            <label class='block text-sm font-medium text-foreground mb-1'
              >Message</label
            ><textarea
              rows='4'
              class='w-full px-4 py-2 border border-input rounded-md bg-background text-foreground'
              placeholder='How can we help?'></textarea>
          </div>
          <button
            type='submit'
            class='w-full py-3 px-4 bg-primary hover:opacity-90 text-primary-foreground font-bold rounded-md shadow-md transition'
            >Send Message</button
          >
        </div>
      </form>
    </div>
  </div>
</Layout>
