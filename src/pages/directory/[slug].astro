---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import PlaceholderNotice from '@/components/shared/PlaceholderNotice.astro';
import DetailSidebar from '@/components/shared/DetailSidebar.astro';
import { businesses } from '@/data/directory';

export function getStaticPaths() {
  return businesses.map((business) => ({
    params: { slug: business.slug },
    props: { business },
  }));
}

const { business } = Astro.props;

const sidebarItems = businesses.map((b) => ({
  href: `/directory/${b.slug}`,
  title: b.name,
  subtitle: b.category,
  active: b.slug === business.slug,
}));
---

<Layout
  title={business.name}
  description={`${business.name} — a Muponda family business (${business.category}).`}
>
  <PageHero
    eyebrow={business.category}
    title={business.name}
    subtitle={`Owner: ${business.owner}`}
    bgClass='bg-muponda-purple'
  />

  <div class='max-w-6xl mx-auto px-6 py-16'>
    <a
      href='/directory'
      class='inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary transition mb-8'
    >
      <i class='fas fa-arrow-left' /> All Businesses
    </a>

    <div class='grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-8'>
      <DetailSidebar heading='All Businesses' items={sidebarItems} />

      <div>
        {
          !business.phone && !business.email && (
            <PlaceholderNotice text='Full details for this business are still to come — see CONTENT-NEEDED.md.' />
          )
        }

        <div class='bg-card border border-border rounded-xl p-6 md:p-10'>
          <div class='flex items-center gap-4 mb-8'>
            <div class='w-14 h-14 rounded-lg bg-muponda-gold/20 text-yellow-700 flex items-center justify-center text-2xl'>
              <i class='fas fa-store' />
            </div>
            <div>
              <p class='text-sm text-muted-foreground'>Owner</p>
              <p class='font-bold text-foreground'>{business.owner}</p>
            </div>
            {
              business.website && (
                <a
                  href={business.website}
                  target='_blank'
                  rel='noopener noreferrer'
                  class='ml-auto inline-flex items-center gap-2 px-4 py-2 rounded-full border border-border text-sm font-semibold text-foreground hover:bg-muted transition'
                >
                  <i class='fas fa-arrow-up-right-from-square' /> Visit Website
                </a>
              )
            }
          </div>

          <p class='text-muted-foreground leading-relaxed mb-6'>
            {business.description}
          </p>

          {
            (business.phone || business.email || business.location) && (
              <div class='flex flex-wrap gap-4 mb-6 text-sm'>
                {business.phone && (
                  <a
                    href={`tel:${business.phone.replace(/\s+/g, '')}`}
                    class='inline-flex items-center gap-2 text-muted-foreground hover:text-primary transition'
                  >
                    <i class='fas fa-phone' /> {business.phone}
                  </a>
                )}
                {business.email && (
                  <a
                    href={`mailto:${business.email}`}
                    class='inline-flex items-center gap-2 text-muted-foreground hover:text-primary transition'
                  >
                    <i class='fas fa-envelope' /> {business.email}
                  </a>
                )}
                {business.location && (
                  <span class='inline-flex items-center gap-2 text-muted-foreground'>
                    <i class='fas fa-location-dot' /> {business.location}
                  </span>
                )}
              </div>
            )
          }

          <div class='border-t border-border pt-6'>
            <h2 class='text-lg font-bold text-foreground mb-3'>Details</h2>
            <p class='text-muted-foreground leading-relaxed'>
              {business.details}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
