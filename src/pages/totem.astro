---
import Layout from '@/layouts/Layout.astro';
---

<Layout title='Totem'>
  <div class='bg-muponda-gold py-16 text-center text-yellow-900'>
    <h1 class='text-3xl md:text-5xl font-serif font-bold mb-4'>
      The Serval Cat
    </h1>
    <p class='text-yellow-800 text-lg font-semibold'>Mutupo: Nyere / Nzvidzi</p>
  </div>
  <div class='max-w-4xl mx-auto px-6 -mt-8 pb-20'>
    <div class='bg-white rounded-lg shadow-xl overflow-hidden'>
      <div class='md:flex'>
        <div class='md:w-1/2 h-64 md:h-auto bg-gray-200 relative'>
          <img
            src='https://images.unsplash.com/photo-1555184857-e923e2714002?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80'
            alt='Serval Cat'
            class='w-full h-full object-cover'
          />
        </div>
        <div class='p-8 md:w-1/2 flex flex-col justify-center'>
          <h3 class='text-2xl font-bold text-gray-900 mb-4'>
            Traits of the Nyere
          </h3>
          <ul class='space-y-4'>
            <li class='flex items-start'>
              <i class='fas fa-check-circle text-muponda-green mt-1 mr-3'></i>
              <div>
                <span class='font-bold text-gray-900'
                  >Visionary (Samaringa)</span
                ><p class='text-sm text-gray-600'>
                  The Serval sees what others miss in the tall grass.
                </p>
              </div>
            </li>
            <li class='flex items-start'>
              <i class='fas fa-check-circle text-muponda-green mt-1 mr-3'></i>
              <div>
                <span class='font-bold text-gray-900'
                  >Skilled Artisans (Mapara)</span
                ><p class='text-sm text-gray-600'>
                  Masters of tanning leather ("Wangopara nhehwe").
                </p>
              </div>
            </li>
          </ul>
        </div>
      </div>
      <!-- Values Section -->
      <div class='bg-gray-50 p-8 border-t border-gray-100 text-center'>
        <h3 class='text-xl font-bold text-gray-900 mb-6'>Family Values</h3>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>
          <div class='p-4 bg-white rounded shadow-sm'>
            <h4 class='font-bold text-muponda-green'>Generosity</h4><p
              class='text-xs text-gray-500 mt-2'
            >
              "Wangopa ngemwoyo wese"
            </p>
          </div>
          <div class='p-4 bg-white rounded shadow-sm'>
            <h4 class='font-bold text-muponda-green'>Forgiveness</h4><p
              class='text-xs text-gray-500 mt-2'
            >
              "Chigumbu chisina unye"
            </p>
          </div>
          <div class='p-4 bg-white rounded shadow-sm'>
            <h4 class='font-bold text-muponda-green'>Excellence</h4><p
              class='text-xs text-gray-500 mt-2'
            >
              "Wangomwa mweru"
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
