---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import PlaceholderNotice from '@/components/shared/PlaceholderNotice.astro';

const categories = [
  { label: 'Sacred Sites', icon: 'fa-mountain-sun' },
  { label: 'Ceremonies', icon: 'fa-fire' },
  { label: 'Reunions', icon: 'fa-people-group' },
  { label: 'Everyday Life', icon: 'fa-house' },
];

const tiles = Array.from({ length: 12 }, (_, i) => ({
  category: categories[i % categories.length],
  wide: i % 5 === 0,
}));
---

<Layout
  title='Gallery'
  description='Photos of the Muponda family — sacred sites, ceremonies and gatherings.'
>
  <PageHero
    eyebrow='Mifananidzo'
    title='Family Gallery'
    subtitle='Sacred sites, ceremonies, reunions and everyday family moments.'
    bgClass='bg-muponda-earth'
  />

  <div class='max-w-6xl mx-auto px-6 py-16'>
    <PlaceholderNotice text='Upload real photos of sacred sites, elders and family events to replace these placeholders.' />

    <div class='grid grid-cols-2 md:grid-cols-4 gap-4'>
      {
        tiles.map((tile) => (
          <div
            class:list={[
              'group relative aspect-square bg-muted rounded-lg overflow-hidden border border-border hover:shadow-lg transition duration-300',
              tile.wide && 'col-span-2 aspect-[2/1]',
            ]}
          >
            <div class='absolute inset-0 flex items-center justify-center'>
              <i class:list={['fas text-4xl text-muted-foreground/30', tile.category.icon]} />
            </div>
            <div class='absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-3'>
              <p class='text-white text-xs font-semibold uppercase tracking-wide'>
                {tile.category.label}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
