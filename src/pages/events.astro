---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import PlaceholderNotice from '@/components/shared/PlaceholderNotice.astro';
import { events } from '@/data/events';
---

<Layout
  title='Events'
  description='Upcoming Muponda family reunions, remembrance ceremonies and gatherings.'
>
  <PageHero
    eyebrow='Zviitiko'
    title='Family Events'
    subtitle='Reunions, remembrance ceremonies and gatherings — mark your calendar.'
    bgClass='bg-muponda-green'
  />

  <div class='max-w-4xl mx-auto px-6 py-16'>
    <PlaceholderNotice text='Add real dates, locations and details for upcoming family events.' />

    <div class='space-y-6'>
      {
        events.map((event) => (
          <a
            href={`/events/${event.slug}`}
            class='group block bg-card border border-border rounded-lg p-6 flex flex-col sm:flex-row gap-4 hover:shadow-lg hover:-translate-y-0.5 transition duration-300'
          >
            <div class='shrink-0 w-full sm:w-32 text-center sm:text-left'>
              <div class='inline-flex sm:flex flex-col items-center sm:items-start bg-muted rounded-lg px-4 py-2'>
                <i class='fas fa-calendar-days text-primary mb-1' />
                <span class='text-sm font-bold text-foreground'>
                  {event.date}
                </span>
              </div>
            </div>
            <div class='flex-1'>
              <h3 class='font-bold text-lg text-foreground group-hover:text-primary transition'>
                {event.title}
              </h3>
              <p class='text-sm text-muted-foreground mb-2'>
                <i class='fas fa-location-dot mr-1' />
                {event.location}
              </p>
              <p class='text-sm text-muted-foreground leading-relaxed'>
                {event.description}
              </p>
              <span class='mt-3 inline-flex items-center gap-1 text-sm font-semibold text-primary'>
                View details <i class='fas fa-arrow-right text-xs' />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
