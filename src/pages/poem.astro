---
import Layout from '@/layouts/Layout.astro';
import { poemStanzas } from '@/data/poem';
---

<Layout
  title='Full Praise Poem'
  description='The full Muponda Dynasty praise poem (Detembo ReNyere), with English translation.'
>
  <div class='bg-primary py-12 text-primary-foreground'>
    <div
      class='max-w-(--container-width) mx-auto px-6 flex flex-col md:flex-row items-center justify-between'
    >
      <div class='mb-4 md:mb-0'>
        <h1 class='text-2xl md:text-3xl font-serif font-bold'>
          Full Praise Poem
        </h1>
        <p class='text-primary-foreground/80 text-sm'>Detembo ReNyere</p>
      </div>
      <a
        href='/culture'
        class='px-6 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg transition border border-white/30 flex items-center'
      >
        <i class='fas fa-arrow-left mr-2'></i> Back to Culture
      </a>
    </div>
  </div>

  <div class='max-w-(--container-width) mx-auto px-6 mt-8 pb-20'>
    <div class='grid grid-cols-1 lg:grid-cols-[240px_1fr] gap-8'>
      <nav class='hidden lg:block bg-card border border-border rounded-xl p-4 lg:sticky lg:top-24 self-start'>
        <h2 class='text-xs font-bold uppercase tracking-widest text-muted-foreground px-2 mb-2'>
          Stanzas
        </h2>
        <ul class='space-y-1'>
          {
            poemStanzas.map((stanza) => (
              <li>
                <a
                  href={`#${stanza.slug}`}
                  class='block rounded-lg px-3 py-2 text-sm text-muted-foreground hover:bg-muted hover:text-foreground transition'
                >
                  {stanza.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <div class='lg:hidden -mx-6 px-6 mb-8 overflow-x-auto'>
          <div class='flex gap-2 w-max'>
            {
              poemStanzas.map((stanza) => (
                <a
                  href={`#${stanza.slug}`}
                  class='shrink-0 px-4 py-2 rounded-full border border-border bg-card text-sm text-muted-foreground hover:bg-muted hover:text-foreground transition whitespace-nowrap'
                >
                  {stanza.title}
                </a>
              ))
            }
          </div>
        </div>

        <div class='flex flex-wrap items-center justify-between gap-4 mb-10'>
          <p class='text-sm text-muted-foreground max-w-md'>
            The praise poem of the Muponda Dynasty (Nyere/Nzvidzi), read as a
            map of our history, sacred sites and ancestors.
          </p>
          <button
            id='toggle-translations'
            class='inline-flex items-center gap-2 px-4 py-2 rounded-full border border-border bg-card text-sm font-semibold text-foreground hover:bg-muted transition shrink-0'
          >
            <i class='fas fa-language'></i>
            <span id='toggle-label'>Hide Translations</span>
          </button>
        </div>

        <div id='poem-content' class='space-y-16'>
          {
            poemStanzas.map((stanza) => (
              <section id={stanza.slug} class='scroll-mt-24'>
                <h3 class='text-xs font-bold uppercase tracking-widest text-muponda-gold mb-6 pb-3 border-b border-border'>
                  {stanza.title}
                </h3>
                <div class='space-y-7'>
                  {stanza.lines.map((line) => (
                    <div>
                      <p class='font-serif text-xl md:text-2xl text-foreground leading-relaxed'>
                        {line.shona}
                      </p>
                      <p class='poem-translation text-muted-foreground italic text-sm md:text-base mt-1.5'>
                        {line.english}
                      </p>
                    </div>
                  ))}
                </div>
              </section>
            ))
          }
        </div>

        <div class='mt-16 text-center border-t border-border pt-8'>
          <a
            href='/culture'
            class='px-8 py-3 bg-primary hover:opacity-90 text-primary-foreground rounded-full transition shadow-md inline-flex items-center'
          >
            <i class='fas fa-arrow-left mr-2'></i> Back to Highlights
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  :global(#poem-content.translations-hidden) :global(.poem-translation) {
    display: none;
  }
</style>

<script>
  const STORAGE_KEY = 'poem-translations-hidden';
  const button = document.getElementById('toggle-translations');
  const label = document.getElementById('toggle-label');
  const content = document.getElementById('poem-content');

  function applyState(hidden: boolean) {
    content?.classList.toggle('translations-hidden', hidden);
    if (label) label.textContent = hidden ? 'Show Translations' : 'Hide Translations';
  }

  applyState(localStorage.getItem(STORAGE_KEY) === 'true');

  button?.addEventListener('click', () => {
    const hidden = !content?.classList.contains('translations-hidden');
    localStorage.setItem(STORAGE_KEY, String(hidden));
    applyState(hidden);
  });
</script>
