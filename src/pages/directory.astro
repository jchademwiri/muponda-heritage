---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import PlaceholderNotice from '@/components/shared/PlaceholderNotice.astro';
import { businesses } from '@/data/directory';
---

<Layout
  title='Family Business Directory'
  description='Support family-owned businesses across the Muponda Dynasty.'
>
  <PageHero
    eyebrow='Mabhizinesi Emhuri'
    title='Family Business Directory'
    subtitle='Discover and support businesses owned by Muponda family members.'
    bgClass='bg-muponda-purple'
  />

  <div class='max-w-5xl mx-auto px-6 py-16'>
    <PlaceholderNotice text='Businesses and owners are confirmed. Category, description and contact details for each are still needed — see CONTENT-NEEDED.md. A submission/approval workflow will come with the member portal.' />

    <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12'>
      {
        businesses.map((b) => (
          <a
            href={`/directory/${b.slug}`}
            class='group bg-card border border-border rounded-lg p-6 hover:shadow-lg hover:-translate-y-1 transition duration-300 flex flex-col'
          >
            <div class='flex items-center gap-3 mb-3'>
              <div class='w-10 h-10 rounded-lg bg-muponda-gold/20 text-yellow-700 flex items-center justify-center group-hover:bg-muponda-gold group-hover:text-white transition'>
                <i class='fas fa-store' />
              </div>
              <div>
                <h3 class='font-bold text-foreground group-hover:text-primary transition'>
                  {b.name}
                </h3>
                <p class='text-xs text-muted-foreground'>{b.category}</p>
              </div>
            </div>
            <p class='text-sm text-muted-foreground mb-2'>
              Owner: {b.owner}
            </p>
            <p class='text-sm text-muted-foreground'>{b.description}</p>
            <span class='mt-4 text-sm font-semibold text-primary inline-flex items-center gap-1'>
              View details <i class='fas fa-arrow-right text-xs' />
            </span>
          </a>
        ))
      }
    </div>

    <div class='bg-muted/50 border border-border rounded-lg p-6 text-center'>
      <p class='text-muted-foreground text-sm'>
        Family members will be able to submit their business once the
        member portal is live.
      </p>
    </div>
  </div>
</Layout>
