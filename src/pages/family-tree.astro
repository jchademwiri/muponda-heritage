---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import PlaceholderNotice from '@/components/shared/PlaceholderNotice.astro';
import FamilyTreeNode from '@/components/shared/FamilyTreeNode.astro';
import { getRoots, familyMembers } from '@/data/family-tree';

const roots = getRoots();
const unconfirmedCount = familyMembers.filter((p) => !p.confirmed).length;
---

<Layout
  title='Family Tree'
  description='Explore the Chademwiri family genealogy — generations, lineages and descendants.'
>
  <PageHero
    eyebrow='Rudzi RweChademwiri'
    title='Family Tree'
    subtitle='A living record of the Chademwiri lineage, from our founding ancestors to today.'
    bgClass='bg-muponda-green'
  />

  <div class='max-w-5xl mx-auto px-6 py-16'>
    <PlaceholderNotice
      text={`This tree is built from data supplied so far. Entries tagged "unconfirmed" (${unconfirmedCount} total) still need verification — see CONTENT-NEEDED.md. Click any name to collapse/expand that branch.`}
    />

    <div class='bg-card border border-border rounded-xl p-6 md:p-10'>
      <ul class='space-y-8'>
        {roots.map((root) => <FamilyTreeNode person={root} />)}
      </ul>
    </div>

    <div class='bg-card border border-border rounded-xl p-8 text-center mt-12'>
      <i class='fas fa-sitemap text-4xl text-muponda-green mb-4'></i>
      <h2 class='text-xl font-bold text-foreground mb-2'>
        Searchable, Zoomable Tree — Coming Soon
      </h2>
      <p class='text-muted-foreground max-w-xl mx-auto'>
        This collapsible list is the first pass. A future version will add
        search, individual profile pages, and a zoomable chart view.
      </p>
    </div>
  </div>
</Layout>
